<includes>

	<include name="HomeWallHeader">
		<control type="group">
			<left>15</left>
			<top>72</top>
			<height>50</height>
			<width>1180</width>
			<include content="FocusedCategoryLabel">
				<param name="id" value=""/>
				<param name="label" value="$VAR[HomescreenFlixCrumbs][COLOR unfocused_text]$INFO[Container($PARAM[row_id]).ListItem.Label][/COLOR]$VAR[HomeFlixCrumbsVar]"/>
				<param name="visible" value="ControlGroup($PARAM[section_id]).HasFocus"/>
			</include>
			<include content="UnfocusedCategoryLabel">
				<param name="id" value=""/>
				<param name="label" value="[COLOR unfocused_text]$INFO[Container($PARAM[row_id]).ListItem.Label][/COLOR]"/>
				<param name="visible" value="!ControlGroup($PARAM[section_id]).HasFocus"/>
			</include>
			<control type="label">
				<align>right</align>
				<right>-205</right>
				<label>$INFO[System.Time]</label>
				<font>font30_title</font>
				<textcolor>unfocused_text</textcolor>
				<shadowcolor>text_shadow</shadowcolor>
				<visible>ControlGroup($PARAM[section_id]).HasFocus</visible>
				<animation effect="fade" time="100">Visible</animation>
			</control>
		</control>
	</include>

	<include name="HomeWallTabLayout">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<top>26</top>
				<left>20</left>
				<width>249</width>
				<height>87</height>
				<control type="image">
					<texture border="20" colordiffuse="66000000">masks/radius_20.png</texture>
				</control>
				<control type="image">
					<texture border="20" colordiffuse="$VAR[FocusColorTheme]">masks/radius_20.png</texture>
					<visible>[$PARAM[focused] + Control.HasFocus($PARAM[row_id])] | [$PARAM[focused] + ControlGroup($PARAM[walls_id]).HasFocus]</visible>
					<include condition="$PARAM[focused]">Animation_FocusTextureFade</include>
				</control>
				<control type="textbox">
					<centertop>50%</centertop>
					<left>20</left>
					<right>20</right>
					<height>87</height>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<textcolor>$VAR[FocusedTextColorVar]</textcolor>
					<font>font23_stacked_widgets_fo</font>
					<autoscroll delay="2000" time="3000" repeat="2000">Control.HasFocus($PARAM[row_id])</autoscroll>
					<visible>[$PARAM[focused] + Control.HasFocus($PARAM[row_id])] | [$PARAM[focused] + ControlGroup($PARAM[walls_id]).HasFocus]</visible>
				</control>
				<control type="textbox">
					<centertop>50%</centertop>
					<left>20</left>
					<right>20</right>
					<height>87</height>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<textcolor>unfocused_text</textcolor>
					<font>font23_stacked_widgets_unfo</font>
					<visible>![[$PARAM[focused] + Control.HasFocus($PARAM[row_id])] | [$PARAM[focused] + ControlGroup($PARAM[walls_id]).HasFocus]]</visible>
				</control>
			</control>
		</definition>
	</include>

	<include name="HomeWallTabRow">
		<top>107</top>
		<width>1424</width>
		<height>140</height>
		<orientation>horizontal</orientation>
		<focusposition>0</focusposition>
		<movement>4</movement>
		<scrolltime tween="cubic" easing="out">400</scrolltime>
		<onfocus>ClearProperty(FlixWidget,Home)</onfocus>
		<onfocus>ClearProperty(FeatureWidgetFocused,Home)</onfocus>
		<onfocus>ClearProperty(altus_stacked_linked_list_id,home)</onfocus>
		<onleft>9000</onleft>
		<onright>$PARAM[row_id]</onright>
		<onup>$PARAM[row_id]</onup>
		<ondown>SetFocus($INFO[Container($PARAM[row_id]).ListItem.Property(wall_id)],0,absolute)</ondown>
		<onback>9000</onback>
		<animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout" condition="ControlGroup($PARAM[walls_id]).HasFocus">Conditional</animation>
		<itemlayout width="283" height="140" infoupdate="30">
			<include content="HomeWallTabLayout">
				<param name="row_id" value="$PARAM[row_id]"/>
				<param name="walls_id" value="$PARAM[walls_id]"/>
			</include>
		</itemlayout>
		<focusedlayout width="283" height="140" infoupdate="30">
			<include content="HomeWallTabLayout">
				<param name="row_id" value="$PARAM[row_id]"/>
				<param name="walls_id" value="$PARAM[walls_id]"/>
				<param name="focused" value="true"/>
			</include>
		</focusedlayout>
	</include>

	<include name="HomeWallSectionSlide">
		<animation effect="slide" start="0,0" end="0,-50" time="400" tween="cubic" easing="out" condition="ControlGroup($PARAM[section_id]).HasFocus" reversible="true">Conditional</animation>
	</include>

	<include name="HomeWallsGroup">
		<top>243</top>
		<animation effect="slide" start="0,0" end="0,-121" time="400" tween="cubic" easing="out" condition="ControlGroup($PARAM[walls_id]).HasFocus" reversible="true">Conditional</animation>
	</include>

	<include name="HomeWallCommon">
		<left>0</left>
		<top>0</top>
		<width>1424</width>
		<height>1008</height>
		<orientation>vertical</orientation>
		<scrolltime tween="cubic" easing="out">600</scrolltime>
		<preloaditems>1</preloaditems>
		<onfocus>ClearProperty(FlixWidget,Home)</onfocus>
		<onfocus>ClearProperty(FeatureWidgetFocused,Home)</onfocus>
		<onfocus>ClearProperty(altus_stacked_linked_list_id,home)</onfocus>
		<onup>SetFocus($PARAM[list_id],0,absolute)</onup>
		<onup>SetFocus($PARAM[row_id])</onup>
		<onleft>SetFocus($PARAM[list_id],0,absolute)</onleft>
		<onleft>SetFocus(9000)</onleft>
		<onright>$PARAM[list_id]</onright>
		<onback condition="Player.HasMedia + !String.IsEmpty(Skin.String(TrailerPlaying))">Stop</onback>
		<onback>SetFocus($PARAM[list_id],0,absolute)</onback>
		<onback>SetFocus($PARAM[row_id])</onback>
		<onunfocus condition="Player.HasMedia + !String.IsEmpty(Skin.String(TrailerPlaying))">Stop</onunfocus>
		<onunfocus condition="!String.IsEmpty(Skin.String(TrailerPlaying))">Skin.Reset(TrailerPlaying)</onunfocus>
	</include>

	<include name="HomeWallUnfocusedAnimations">
		<animation condition="Skin.HasSetting(Enable.HomeWallsDim) + Control.HasFocus($PARAM[list_id]) + String.IsEqual(Skin.String(BackgroundSetting),1)" reversible="true">
			<effect type="fadediffuse" start="FFFFFFFF" end="FF777777" time="300" />
		</animation>
		<animation condition="Skin.HasSetting(Enable.HomeWallsDim) + Control.HasFocus($PARAM[list_id]) + [String.IsEqual(Skin.String(BackgroundSetting),0) | String.IsEqual(Skin.String(BackgroundSetting),2)]" reversible="true">
			<effect type="fade" start="100" end="50" time="300" tween="sine" easing="inout" />
		</animation>
	</include>

	<include name="HomeWallContent">
		<content sortby="$PARAM[sortby]" sortorder="$PARAM[sortorder]" target="$PARAM[widget_target]" limit="$PARAM[limit]">$PARAM[content_path]</content>
	</include>

	<include name="HomeWallFrame">
		<animation effect="fade" time="200">Visible</animation>
		<visible>$PARAM[visible]</visible>
